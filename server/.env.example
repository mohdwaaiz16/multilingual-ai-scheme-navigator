# Environment Configuration

# Server Port
PORT=3000

# PostgreSQL Database Connection String
# Example: postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schemesathi?schema=public"

# Supabase Keys for Authentication & Client Access
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Provider Configuration (Optional depending on usage)
AI_PROVIDER="openai" # openai, gemini, anthropic
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Scheme Importer Configuration
MYSCHEME_REQUEST_DELAY_MS=1000
MYSCHEME_MAX_RETRIES=3
MYSCHEME_TIMEOUT_MS=10000
